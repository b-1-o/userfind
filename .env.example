# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Generate with: npm run auth. Keep private.
TG_SESSION=

# Numeric Telegram user IDs allowed to run scans/checks.
# Start the bot, send /id, add your ID here, then restart.
BOT_ALLOWED_USER_IDS=

# Conservative sequential MTProto checking.
CHECK_INTERVAL_MS=1500
SEARCH_DURATION_MS=600000
MAX_CANDIDATES=6000
MAX_RESULTS=15